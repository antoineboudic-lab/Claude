# ============================================================
# OpusLearn — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is gitignored.
#
# ENVIRONMENTS
#   .env.local     → DEV  (local development, dev Supabase project, Stripe test mode)
#   Vercel env     → PROD (production, prod Supabase project, Stripe live mode)
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# DEV:  Use the "opuslearn-dev" Supabase project credentials
# PROD: Use the "opuslearn" (main) Supabase project credentials
# Found at: supabase.com → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secret used to validate Supabase auth webhook calls
# Generate with: openssl rand -hex 32
SUPABASE_WEBHOOK_SECRET=<random-hex-string>

# ------------------------------------------------------------
# STRIPE
# DEV:  sk_test_... keys + test price IDs + test webhook secret
# PROD: sk_live_... keys + live price IDs + live webhook secret
# Found at: dashboard.stripe.com → Developers → API keys
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>

# Price IDs — create in Stripe Products tab
# DEV:  test mode price IDs
# PROD: live mode price IDs
STRIPE_MONTHLY_PRICE_ID=price_<monthly-price-id>
STRIPE_ANNUAL_PRICE_ID=price_<annual-price-id>

# Webhook signing secret
# DEV:  run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#       and use the whsec_... it prints
# PROD: from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_<signing-secret>

# ------------------------------------------------------------
# RESEND (email)
# Same key works for both environments
# DEV: emails still send — use a test inbox or your own email
# Found at: resend.com → API Keys
# ------------------------------------------------------------
RESEND_API_KEY=re_<your-resend-api-key>

# ------------------------------------------------------------
# ANTHROPIC (AI tutor)
# Same key works for both environments
# Found at: console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>

# ------------------------------------------------------------
# APP
# DEV:  http://localhost:3000
# PROD: https://opuslearn.ai
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated admin email addresses
ADMIN_EMAILS=your@email.com
NEXT_PUBLIC_ADMIN_EMAILS=your@email.com

# Secret for protecting cron job endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=<random-hex-string>

# ------------------------------------------------------------
# POSTHOG (analytics)
# Same key works for both environments
# Found at: app.posthog.com → Project Settings
# ------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_<your-posthog-key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
